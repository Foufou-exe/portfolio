# ============================================================================
# PORTFOLIO - CONFIGURATION DEVELOPPEMENT
# ============================================================================
# Copiez ce fichier vers .env pour le developpement local
# cp .env.example.dev .env
#
# Documentation: https://nuxt.com/docs/guide/directory-structure/env
# ============================================================================

# ============================================================================
# ENVIRONNEMENT
# ============================================================================
NODE_ENV=development

# ============================================================================
# APPLICATION - URLs & Identification
# ============================================================================

# URL du site (utilisee pour SEO, Open Graph, liens canoniques)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Port du serveur de developpement
NUXT_PORT=3000

# Host du serveur (0.0.0.0 pour exposer sur le reseau local)
NUXT_HOST=localhost

# ============================================================================
# SEO & METADONNEES
# ============================================================================

# Nom du site (balise title, Open Graph)
NUXT_PUBLIC_SITE_NAME="Thibaut Maurras - Portfolio [DEV]"

# Description du site (meta description, Open Graph)
NUXT_PUBLIC_SITE_DESCRIPTION="Portfolio de Thibaut Maurras - Environnement de developpement"

# Auteur du site
NUXT_PUBLIC_SITE_AUTHOR="Thibaut Maurras"

# Mots-cles SEO (separes par des virgules)
NUXT_PUBLIC_SITE_KEYWORDS="developpeur,ingenieur logiciel,full stack,vue,nuxt,typescript,portfolio"

# Image Open Graph (chemin relatif depuis /public ou URL absolue)
NUXT_PUBLIC_OG_IMAGE=/og-image.webp

# ============================================================================
# GITHUB API
# ============================================================================
# Token d'acces personnel GitHub
# - Augmente le rate limit de 60 a 5000 requetes/heure
# - Permet d'acceder aux repos epingles via GraphQL
# - Creer sur: https://github.com/settings/tokens
# - Scopes necessaires: public_repo (lecture repos publics)

NUXT_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NUXT_GITHUB_USERNAME=votre-username-github

# ============================================================================
# SMTP - FORMULAIRE DE CONTACT
# ============================================================================
# Configuration pour l'envoi d'emails via Nodemailer
#
# Pour Gmail:
# 1. Activer la validation en 2 etapes: https://myaccount.google.com/security
# 2. Generer un mot de passe d'application: https://myaccount.google.com/apppasswords
#    - Selectionner "Mail" et "Ordinateur Windows/Mac"
#    - Copier le mot de passe genere (16 caracteres)
#
# Note: Sans configuration SMTP, le formulaire fonctionne en "mode demo"
# (simule l'envoi sans reellement envoyer d'email)

# Serveur SMTP (smtp.gmail.com pour Gmail)
NUXT_SMTP_HOST=smtp.gmail.com

# Port SMTP (587 = TLS/STARTTLS, 465 = SSL)
NUXT_SMTP_PORT=587

# Email d'authentification SMTP
NUXT_SMTP_USER=votre-email@gmail.com

# Mot de passe d'application (16 caracteres, sans espaces)
NUXT_SMTP_PASS=xxxx xxxx xxxx xxxx

# Email destinataire du formulaire de contact
NUXT_CONTACT_EMAIL=votre-email@gmail.com

# ============================================================================
# OUTILS DE DEVELOPPEMENT
# ============================================================================

# Activer Nuxt DevTools (panneau de debug dans le navigateur)
NUXT_DEVTOOLS=true

# Mode debug (logs supplementaires dans la console)
NUXT_DEBUG=true
