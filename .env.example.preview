# ============================================================================
# PORTFOLIO - CONFIGURATION PREVIEW/STAGING
# ============================================================================
# Variables d'environnement pour les deploiements de preview/staging
#
# Utilise pour:
# - Pull Request previews (Vercel, Netlify, Cloudflare)
# - Environnement de staging/test
# - Branches de feature avant merge en production
#
# Documentation: https://nuxt.com/docs/guide/directory-structure/env
# ============================================================================

# ============================================================================
# ENVIRONNEMENT
# ============================================================================
NODE_ENV=production

# ============================================================================
# APPLICATION - URLs & Identification
# ============================================================================

# URL du site preview (generee automatiquement par la plateforme)
# Exemples:
# - Vercel: https://project-git-branch-username.vercel.app
# - Netlify: https://deploy-preview-123--project.netlify.app
# - Cloudflare: https://branch.project.pages.dev
#
# Note: Certaines plateformes injectent automatiquement cette variable
# Vercel: VERCEL_URL, Netlify: DEPLOY_URL, Cloudflare: CF_PAGES_URL
NUXT_PUBLIC_SITE_URL=https://preview.votre-domaine.com

# ============================================================================
# SEO & METADONNEES
# ============================================================================

# Nom du site avec indicateur preview
NUXT_PUBLIC_SITE_NAME="Thibaut Maurras - Portfolio [PREVIEW]"

# Description avec mention preview
NUXT_PUBLIC_SITE_DESCRIPTION="Apercu du portfolio - Version en cours de developpement"

# Auteur du site
NUXT_PUBLIC_SITE_AUTHOR="Thibaut Maurras"

# Mots-cles SEO
NUXT_PUBLIC_SITE_KEYWORDS="developpeur,ingenieur logiciel,full stack,vue,nuxt,typescript,portfolio,preview"

# Image Open Graph
NUXT_PUBLIC_OG_IMAGE=/og-image.webp

# ============================================================================
# GITHUB API
# ============================================================================
# Meme configuration qu'en production
# Note: Vous pouvez utiliser un token different avec moins de permissions
# pour les environnements de preview

NUXT_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NUXT_GITHUB_USERNAME=votre-username-github

# ============================================================================
# SMTP - FORMULAIRE DE CONTACT
# ============================================================================
# Option 1: Mode demo (pas de configuration = simule l'envoi)
# Option 2: Email de test (envoie a une adresse de test)
# Option 3: Service comme Mailtrap pour capturer les emails sans les envoyer

# Pour utiliser Mailtrap (capture les emails sans les envoyer):
# NUXT_SMTP_HOST=sandbox.smtp.mailtrap.io
# NUXT_SMTP_PORT=587
# NUXT_SMTP_USER=votre-user-mailtrap
# NUXT_SMTP_PASS=votre-pass-mailtrap

# Configuration standard (optionnelle pour preview)
NUXT_SMTP_HOST=smtp.gmail.com
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=votre-email@gmail.com
NUXT_SMTP_PASS=xxxx xxxx xxxx xxxx
NUXT_CONTACT_EMAIL=votre-email-test@gmail.com

# ============================================================================
# OUTILS DE DEVELOPPEMENT
# ============================================================================

# DevTools actives pour faciliter le debug des previews
NUXT_DEVTOOLS=true

# Debug actif pour tracer les problemes
NUXT_DEBUG=true
