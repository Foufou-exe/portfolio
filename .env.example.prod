# ============================================================================
# PORTFOLIO - CONFIGURATION PRODUCTION
# ============================================================================
# Variables d'environnement pour le deploiement en production
#
# IMPORTANT: Ne jamais commiter ce fichier avec des valeurs reelles!
# Utilisez les secrets de votre plateforme de deploiement:
# - Vercel: Project Settings > Environment Variables
# - Netlify: Site Settings > Build & Deploy > Environment
# - Cloudflare Pages: Settings > Environment Variables
# - GitHub Actions: Repository Settings > Secrets and Variables
#
# Documentation: https://nuxt.com/docs/guide/directory-structure/env
# ============================================================================

# ============================================================================
# ENVIRONNEMENT
# ============================================================================
NODE_ENV=production

# ============================================================================
# APPLICATION - URLs & Identification
# ============================================================================

# URL du site en production (OBLIGATOIRE)
# Utilisee pour: SEO, Open Graph, liens canoniques, sitemap
NUXT_PUBLIC_SITE_URL=https://votre-domaine.com

# ============================================================================
# SEO & METADONNEES
# ============================================================================

# Nom du site (balise title, Open Graph)
NUXT_PUBLIC_SITE_NAME="Thibaut Maurras - Portfolio"

# Description du site (meta description, Open Graph)
# Recommandation: 150-160 caracteres max
NUXT_PUBLIC_SITE_DESCRIPTION="Ingenieur Logiciel passionne par l'innovation et le developpement de solutions technologiques."

# Auteur du site
NUXT_PUBLIC_SITE_AUTHOR="Thibaut Maurras"

# Mots-cles SEO (separes par des virgules)
NUXT_PUBLIC_SITE_KEYWORDS="developpeur,ingenieur logiciel,full stack,vue,nuxt,typescript,portfolio"

# Image Open Graph (URL absolue recommandee en production)
# Dimensions recommandees: 1200x630px
NUXT_PUBLIC_OG_IMAGE=/og-image.webp

# ============================================================================
# GITHUB API (OBLIGATOIRE pour afficher les projets)
# ============================================================================
# Token d'acces personnel GitHub
# - Creer sur: https://github.com/settings/tokens
# - Type: Fine-grained personal access token (recommande)
# - Permissions: Public Repositories (read-only)
# - Expiration: 90 jours recommande (avec renouvellement automatise)

NUXT_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NUXT_GITHUB_USERNAME=votre-username-github

# ============================================================================
# SMTP - FORMULAIRE DE CONTACT (OBLIGATOIRE)
# ============================================================================
# Sans configuration SMTP, le formulaire fonctionnera en mode demo
#
# Options recommandees pour la production:
# - Gmail: smtp.gmail.com (gratuit, limite 500 emails/jour)
# - SendGrid: smtp.sendgrid.net (100 emails/jour gratuits)
# - Mailgun: smtp.mailgun.org (5000 emails/mois pendant 3 mois)
# - Amazon SES: email-smtp.region.amazonaws.com (62000 emails/mois si depuis EC2)

# Serveur SMTP
NUXT_SMTP_HOST=smtp.gmail.com

# Port SMTP (587 = TLS, 465 = SSL)
NUXT_SMTP_PORT=587

# Identifiants SMTP
NUXT_SMTP_USER=votre-email@gmail.com
NUXT_SMTP_PASS=xxxx xxxx xxxx xxxx

# Email destinataire du formulaire de contact
NUXT_CONTACT_EMAIL=votre-email@gmail.com

# ============================================================================
# OUTILS DE DEVELOPPEMENT (DESACTIVES EN PRODUCTION)
# ============================================================================

# Nuxt DevTools (toujours desactive en production)
NUXT_DEVTOOLS=false

# Mode debug (desactive pour les performances)
NUXT_DEBUG=false
