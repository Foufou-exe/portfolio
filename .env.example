# ============================================================================
# PORTFOLIO - CONFIGURATION ENVIRONNEMENT
# ============================================================================
#
# Ce fichier liste toutes les variables d'environnement utilisees par l'application.
#
# UTILISATION:
# -----------
# 1. Copiez le fichier correspondant a votre environnement:
#    - Developpement: cp .env.example.dev .env
#    - Production:    cp .env.example.prod .env
#    - Preview:       cp .env.example.preview .env
#
# 2. Remplissez les valeurs dans votre fichier .env
#
# 3. Ne commitez JAMAIS le fichier .env contenant vos secrets!
#
# FICHIERS DISPONIBLES:
# --------------------
# .env.example.dev     - Configuration pour le developpement local
# .env.example.prod    - Configuration pour la production
# .env.example.preview - Configuration pour les previews/staging
#
# DOCUMENTATION:
# -------------
# https://nuxt.com/docs/guide/directory-structure/env
# ============================================================================

# ============================================================================
# VARIABLES REQUISES
# ============================================================================

# --- Application ---
NODE_ENV=development                              # development | production | test
NUXT_PUBLIC_SITE_URL=http://localhost:3000        # URL complete du site

# --- GitHub API (pour afficher les projets) ---
NUXT_GITHUB_TOKEN=ghp_xxxxxxxx                    # Token GitHub (https://github.com/settings/tokens)
NUXT_GITHUB_USERNAME=username                     # Nom d'utilisateur GitHub

# ============================================================================
# VARIABLES OPTIONNELLES
# ============================================================================

# --- SEO & Metadonnees ---
NUXT_PUBLIC_SITE_NAME="Nom du Site"               # Titre du site
NUXT_PUBLIC_SITE_DESCRIPTION="Description"        # Meta description
NUXT_PUBLIC_SITE_AUTHOR="Auteur"                  # Auteur
NUXT_PUBLIC_SITE_KEYWORDS="mot1,mot2"             # Mots-cles SEO
NUXT_PUBLIC_OG_IMAGE=/og-image.webp               # Image Open Graph

# --- SMTP (formulaire de contact) ---
# Sans configuration = mode demo (simule l'envoi)
NUXT_SMTP_HOST=smtp.gmail.com                     # Serveur SMTP
NUXT_SMTP_PORT=587                                # Port (587=TLS, 465=SSL)
NUXT_SMTP_USER=email@gmail.com                    # Email authentification
NUXT_SMTP_PASS=xxxx xxxx xxxx xxxx                # Mot de passe application
NUXT_CONTACT_EMAIL=email@gmail.com                # Destinataire du formulaire

# --- Developpement ---
NUXT_DEVTOOLS=false                               # Nuxt DevTools
NUXT_DEBUG=false                                  # Mode debug
NUXT_PORT=3000                                    # Port serveur
NUXT_HOST=localhost                               # Host serveur
