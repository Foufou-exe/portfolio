# ====================================
# PORTFOLIO - CONFIGURATION
# ====================================
# Copiez ce fichier vers .env et remplissez les valeurs
# cp .env.example .env

# ====================================
# APPLICATION
# ====================================

# Environnement (development | production | test)
NODE_ENV=development

# URL du site (utilisee pour les metadonnees SEO et les liens absolus)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ====================================
# SMTP - NODEMAILER (Gmail)
# ====================================
# Pour Gmail, vous devez :
# 1. Activer la validation en 2 etapes sur votre compte Google
# 2. Generer un "Mot de passe d'application" :
#    - Allez sur https://myaccount.google.com/apppasswords
#    - Selectionnez "Mail" et "Ordinateur Windows"
#    - Copiez le mot de passe genere (16 caracteres sans espaces)
#
# Configuration Gmail :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-email@gmail.com
# SMTP_PASS=votre-mot-de-passe-application

# Serveur SMTP
NUXT_SMTP_HOST=smtp.gmail.com

# Port SMTP (587 pour TLS, 465 pour SSL)
NUXT_SMTP_PORT=587

# Email d'authentification SMTP
NUXT_SMTP_USER=votre-email@gmail.com

# Mot de passe d'application Gmail (16 caracteres)
NUXT_SMTP_PASS=xxxx xxxx xxxx xxxx

# Email de destination pour le formulaire de contact
# C'est l'email qui recevra les messages du formulaire
NUXT_CONTACT_EMAIL=votre-email@gmail.com

# ====================================
# GITHUB API
# ====================================
# Token d'acces personnel GitHub (optionnel, pour augmenter les limites de l'API)
NUXT_GITHUB_TOKEN=Access_Token_ICI
# Nom d'utilisateur GitHub
NUXT_GITHUB_USERNAME=octocat

# ====================================
# SEO & METADONNEES
# ====================================

# Nom du site (utilise dans les balises title et meta)
NUXT_PUBLIC_SITE_NAME="Thibaut Maurras - Portfolio"

# Description du site (meta description)
NUXT_PUBLIC_SITE_DESCRIPTION="Ingenieur Logiciel passionne par l'innovation et le developpement de solutions technologiques."

# Auteur du site
NUXT_PUBLIC_SITE_AUTHOR="Thibaut Maurras"

# Mots-cles SEO (separes par des virgules)
NUXT_PUBLIC_SITE_KEYWORDS="developpeur,ingenieur logiciel,full stack,vue,nuxt,typescript,portfolio"

# Image par defaut pour les partages sociaux (Open Graph)
# Chemin relatif depuis /public ou URL absolue
NUXT_PUBLIC_OG_IMAGE=/og-image.png

# ====================================
# DEVELOPPEMENT
# ====================================

# Activer Nuxt DevTools
NUXT_DEVTOOLS=false

# Activer le mode debug (logs supplementaires)
NUXT_DEBUG=false

# Port du serveur de developpement
NUXT_PORT=3000

# Host du serveur de developpement
NUXT_HOST=localhost

# Activer le hot reload
NUXT_HOT_RELOAD=true